# Ambiente
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nexa_workspace

# Security
JWT_SECRET=your-super-secret-jwt-key-min-256-bits
PASSWORD_PEPPER=your-super-secret-pepper-key-min-256-bits

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100